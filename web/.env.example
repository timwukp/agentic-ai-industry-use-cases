# Copy to .env.local and fill in from the deployed stack outputs.

# AWS region of the Cognito user pool and AgentCore harness
VITE_REGION=us-west-2

# Cognito user pool (auth)
VITE_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard REST API (API Gateway HTTP API base URL, no trailing slash)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-west-2.amazonaws.com

# Agent invoke base URL. May be same-origin (e.g. '/agent' behind a proxy)
# or a full URL to the AgentCore data-plane proxy.
VITE_AGENT_ENDPOINT=/agent

# AgentCore Harness ARN to invoke
VITE_HARNESS_ARN=arn:aws:bedrock-agentcore:us-west-2:000000000000:harness/example

# Optional per-industry harness ARNs; setting one enables that industry's chat
VITE_HARNESS_ARN_HEALTHCARE=
